<?xml version="1.0" encoding="utf-8"?>
<Mdl xsi:noNamespaceSchemaLocation="\\searchdata\apps\MDL\Mdl.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:foray="extension://MDLConverters/ForayConverter" xsi:schemaLocation="extension://MDLConverters/ForayConverter \\searchdata\apps\MDL\ForayConverter.xsd">
  <Computations>
    <Column Type="string" Level="Base" Name="IG" IsPublic="true">
      <Definition><![CDATA[
        syntheticscorecardtestgithubNamespace.impression_id
      ]]></Definition>
    </Column>
    <Column Type="string" Level="Base" Name="SESSION_ID" IsPublic="true">
      <Definition><![CDATA[
        syntheticscorecardtestgithubNamespace.clientid
      ]]></Definition>
    </Column>
    <Column Type="string" Level="Base" Name="USER" IsPublic="true">
      <Definition><![CDATA[
        syntheticscorecardtestgithubNamespace.clientid
      ]]></Definition>
    </Column>
    <Column Type="string" Level="Base" Name="RAWMUID" IsPublic="true">
      <Definition><![CDATA[
        syntheticscorecardtestgithubNamespace.clientid
