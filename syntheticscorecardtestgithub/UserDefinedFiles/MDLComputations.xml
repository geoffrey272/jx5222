      <Definition><![CDATA[MAX(MaxQueryTime)]]></Definition>
    </Column>
    <foray:Statistic Levels="ImpressionId,ClientId" Name="QCNT">
      <foray:Definition><![CDATA[STAVG(QCNT_ImpressionId)]]></foray:Definition>
    </foray:Statistic>
    <foray:Statistic Levels="ImpressionId,ClientId" Name="MinQueryDate">
      <foray:Definition><![CDATA[STMIN(MinQueryDate_ImpressionId)]]></foray:Definition>
    </foray:Statistic>
    <foray:Statistic Levels="ImpressionId,ClientId" Name="MaxQueryDate">
      <foray:Definition><![CDATA[STMAX(MaxQueryDate_ImpressionId)]]></foray:Definition>
    </foray:Statistic>
    <foray:Statistic Levels="ImpressionId,ClientId" Name="MinQueryTime">
      <foray:Definition><![CDATA[STMIN(MinQueryTime_ImpressionId)]]></foray:Definition>
    </foray:Statistic>
    <foray:Statistic Levels="ImpressionId,ClientId" Name="MaxQueryTime">
      <foray:Definition><![CDATA[STMAX(MaxQueryTime_ImpressionId)]]></foray:Definition>
    </foray:Statistic>
    <Column Type="string" Level="Base" Name="FLIGHT" IsPublic="true">
      <Definition><![CDATA[OnboardingCommonHelper.ForayCommonHelper.MatchFlight(assignmentContext, ';',"#Flights#",'|')]]></Definition>
    </Column>
    <Column Type="string" Level="Base" Name="PRIMARY_FLIGHT" IsPublic="true">
      <Definition><![CDATA[OnboardingCommonHelper.ForayCommonHelper.MatchFlight(assignmentContext, ';',"#Flights#",'|')]]></Definition>
    </Column>
    <Column Type="string" Level="Base" Name="DATE" IsPublic="true">
      <Definition><![CDATA[datetime.ToString("yyyy-MM-dd")]]></Definition>
      <Extensions>
        <foray:IsForaySegment>true</foray:IsForaySegment>
      </Extensions>
    </Column>
    <Column Type="int" Level="Base" Name="QCNT" IsPublic="false">
