    <Column Type="string" Level="ImpressionId" Name="MinQueryDate_ImpressionId" IsPublic="false">
      <Definition><![CDATA[MIN(MinQueryDate)]]></Definition>
    </Column>
    <Column Type="string" Level="ImpressionId" Name="MaxQueryDate_ImpressionId" IsPublic="false">
