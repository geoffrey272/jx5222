    </Column>
    <Column Type="string" Level="Base" Name="REQUEST_TIME" IsPublic="true">
      <Definition><![CDATA[datetime.ToString("o")]]></Definition>
    </Column>
    <Column Type="string" Level="Base" Name="MinQueryDate" IsPublic="false">
      <Definition><![CDATA[datetime.ToString("yyyy-MM-dd")]]></Definition>
    </Column>
    <Column Type="string" Level="Base" Name="MaxQueryDate" IsPublic="false">
      <Definition><![CDATA[datetime.ToString("yyyy-MM-dd")]]></Definition>
    </Column>
    <Column Type="string" Level="Base" Name="MinQueryTime" IsPublic="false">
      <Definition><![CDATA[datetime.ToString("o")]]></Definition>
    </Column>
    <Column Type="string" Level="Base" Name="MaxQueryTime" IsPublic="false">
      <Definition><![CDATA[datetime.ToString("o")]]></Definition>
    </Column>
